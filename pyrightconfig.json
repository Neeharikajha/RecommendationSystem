{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.13",
  "include": [
    "backend"
  ],
  "extraPaths": [
    "backend"
  ],
  "exclude": [
    "frontend",
    "**/__pycache__",
    "**/.venv",
    "**/node_modules"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "backend"
      ]
    }
  ]
}
